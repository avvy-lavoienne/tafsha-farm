# Salin ke .env.local lalu isi dari dashboard Supabase
# (Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://ouizkqahvkljglkqucxn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Push VAPID (M5 P0-1): isi dari `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contoh@email.com
# Secret cron pengirim push (acak 32 hex)
CRON_SECRET=
# WAJIB untuk landing publik (/api/publik/*): ambil di Supabase Dashboard
# Project Settings > API > service_role (jangan pakai anon/publishable)
SUPABASE_SERVICE_ROLE_KEY=
# Opsional: domain publik untuk URL absolut Open Graph/Twitter.
# Di Vercel otomatis memakai VERCEL_PROJECT_PRODUCTION_URL bila kosong.
NEXT_PUBLIC_SITE_URL=
